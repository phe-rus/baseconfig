{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baseconfig",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/server.ts",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baseconfig-dev",
      "database_id": "REPLACE_WITH_REAL_D1_ID",
      "migrations_dir": "./.migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "baseconfig-media-dev"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_REAL_KV_ID"
    }
  ]
}